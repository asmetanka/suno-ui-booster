# Auto detect text files and perform LF normalization
* text=auto

# JavaScript files
*.js text eol=lf
*.mjs text eol=lf

# JSON files (important for manifest.json)
*.json text eol=lf

# HTML files
*.html text eol=lf

# CSS files
*.css text eol=lf

# Markdown files
*.md text eol=lf

# Shell scripts
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary

# License files
LICENSE text eol=lf
*.md text eol=lf
